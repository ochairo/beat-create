{
  "name": "@ochairo/beat-create",
  "version": "2.0.0",
  "description": "Scaffold a Beat application with Vite, TypeScript, and Pulse.",
  "type": "module",
  "bin": {
    "create-beat": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "templates/**"
  ],
  "keywords": [
    "beat",
    "create-beat",
    "scaffold",
    "vite",
    "ochairo"
  ],
  "author": "ochairo",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ochairo/beat-create"
  },
  "homepage": "https://ochairo.github.io/beat-site/",
  "bugs": {
    "url": "https://github.com/ochairo/beat-create/issues"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  }
}
